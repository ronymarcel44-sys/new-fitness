# ── Copy this file to .env and fill in your values ───────────────────────────
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Your local PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Default PostgreSQL user is "postgres", default port is 5432
DATABASE_URL="postgresql://postgres:12345@localhost:5432/fitai"


VITE_API_URL="http://localhost:3001"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Make this a long random string — used to sign JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="af6813f665b48bc17c04469ac44ee350fcfa73d39142e98aa47ed77a11fe5ac4f8da1d0693d02cced437aabe2f5fd4d51f85e78e30614fd937cb3190a633d0f1"

# How long until access token expires (15 minutes recommended)
JWT_ACCESS_EXPIRES="15m"

# How long until refresh token expires (7 days recommended)
JWT_REFRESH_EXPIRES="7d"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

