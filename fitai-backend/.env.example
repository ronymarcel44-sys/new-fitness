# Copy this file to ".env" and fill in your own values.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fitai"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Any long random string (used to sign JWTs).
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ── Groq API (the AI coach) — required ────────────────────────────────────────
# Free key from https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key"

# ── CORS / redirects ──────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── Stripe (premium checkout) — optional, test mode only ──────────────────────
# Free test key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY="sk_test_your_stripe_test_key"
